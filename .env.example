APP_NAME=IR Block Planning
APP_ENV=development
DEBUG=true
API_PREFIX=/api/v1
# Allowed CORS origins for FastAPI (comma-separated). Add your custom domain or Vercel URL on Render.
CORS_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app

DATABASE_URL=postgresql+psycopg2://ir_block:ir_block@localhost:5432/block_planning
DB_ECHO=false

OPTIMIZER_TIME_LIMIT_SECONDS=30
ML_MODEL_PATH=app/ml/priority_model.joblib
EXPORT_DIR=exports
